{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@data/*": [
        "./data/*"
      ]
    }
  },
  "include": [
    "src",
    "scripts",
    "vite.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".ssr",
    ".next",
    "out",
    "app",
    "components",
    "lib",
    "src/content/config.ts"
  ]
}
